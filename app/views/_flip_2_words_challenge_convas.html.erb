<%
=begin
  # This is a partial view for the Flip2WordsChallenge canvas. It includes the necessary HTML and JavaScript to display the challenge and handle user interactions.
  # The challenge consists of two words that are flipped and the user must identify them correctly to pass the challenge.
  # The JavaScript code handles the flipping animation and checks the user's answers against the correct words.
  # The partial can be included in any view where you want to present the Flip2WordsChallenge to the user.
=end
-%>
<div id="flip-2-words-challenge" class="challenge-container">
  <div class="challenge-header">
    <h2>Flip 2 Words Challenge</h2>
    <p>Flip the dots/cells to the same colors to represent the strokes of the wanted words.</p>
  </div>
  <div class="challenge-body">
    <div class="flipped-words">
      <div class="flipped-word" id="flipped-word-1">???</div>
      <div class="flipped-word" id="flipped-word-2">???</div>
    </div>
    <div class="user-inputs">
      <form id="flip-2-words-challenge-form" onsubmit="checkFlip2WordsChallenge()">
        <input type="text" id="user-word-1" placeholder="Enter first word">
        <input type="text" id="user-word-2" placeholder="Enter second word">
      </form>
    </div>
    <button id="submit-challenge" class="challenge-button">Submit</button>
  </div>
</div>