<% # Require locals:
  # - letter: the letter to display
  # - positions: an array of booleans indicating which positions are chosen for the letter
  positions = [] unless defined?(positions) && positions.is_a?(Array)
  letter ||= ''
  mulivalues = FlipLetter::POSITION_VALUES.map{ |pos| pos.to_s }.join(",")
-%>
<%= form_tag update_flip_letter_path, method: :post, remote: true, id: "letter_form", name: "letter_form" do %>
  <div>
    <label for="letter" class="form-label fw-bold" style="line-height: 2em; margin-right: 0.2em;">Letter to Flip: </label>
    <%= text_field_tag :letter, params[:letter], id: "letter_field", style: "text-transform: uppercase; width: 1.2em; font-size: 14pt;", maxlength: 1, required: true, onchange: "resetPositionCheckboxes('#letter_form')" %>
  </div>
  <div class="card">
    <div class="card-body text-center">
      <table style="margin: 0 auto;">
        <tbody>
          <% 1.upto(FlipLetter::ROWS_FOR_LETTER) do |row| %>
            <tr>
              <% 1.upto(FlipLetter::COLUMNS_FOR_LETTER) do |col| 
                pos = (row - 1) * FlipLetter::COLUMNS_FOR_LETTER + (col - 1)
                init_color = positions[pos] ? "f2w-#{positions[pos] }" : ""
              %>
                <td class="letter-position-cell">
                  <%= check_box_tag "positions[#{pos}]", (positions[pos] || 0).to_s, mulivalues.include?(positions[pos].to_s), { class: "letter-position-checkbox", data: { 'bs-toggle': 'tooltip', 'bs-title': 'Empty, Must, Optional', multiple_values: mulivalues }, onclick: "toggleMultivalueCheckbox(event)" } %>
                </td>
              <% end %>
            </tr>
          <% end # each row %>
        </tbody>
      </table>
      <div class="mt-3">
        <%= submit_tag "Save", class: "btn btn-primary", data: { disable_with: "Saving..." } %>
        <span class="m-2">&nbsp;</span>
        <% if @letter.present? %>
          <%= link_to "Delete", delete_flip_letter_path(letter: @letter), class: "btn btn-sm btn-danger mt-2", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        <% end %>
        <button type="button" value="Reset" class="btn btn-sm btn-secondary mt-2" id="reset_positions" onclick="resetPositionCheckboxes('#letter_form')">Reset</button>
      </div>
    </div>
  </div>
<% end # form %>