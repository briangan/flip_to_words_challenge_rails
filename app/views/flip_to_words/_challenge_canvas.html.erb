<%
=begin
  # This is a partial view for the Flip2WordsChallenge canvas. It includes the necessary HTML and JavaScript to display the challenge and handle user interactions.
  # The challenge consists of two words that are flipped and the user must identify them correctly to pass the challenge.
  # The JavaScript code handles the flipping animation and checks the user's answers against the correct words.
  # The partial can be included in any view where you want to present the Flip2WordsChallenge to the user.
=end
-%>
<div id="flip_to_words_challenge" class="challenge-container">
  <h3 class="text-bg-primary p-2"><%= t('flip_to_words_challenge.instructions') || 'Flip the checkboxes to show the ASCII form of the letters, to verify human interaction.'%></h3>
  <%= form_tag verify_flip_to_words_challenge_path, method: :post, data: { turbo: false } do %>
    <div class="row">
      <div class="col col-md-auto accordion">
        <div class="accordion-item">
          <h2 class="accordion-header " id="flipLetterDemoHeading">
            <button class="accordion-button text-bg-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#flipLetterDemoCollapse" aria-expanded="false" aria-controls="flipLetterDemoCollapse">
              <%= t('flip_to_words_challenge.avoid_curved_corners_message') || "Avoid checkboxes at curved corners." %>
            </button>
          </h2>
          <div id="flipLetterDemoCollapse" class="bg-light accordion-collapse collapse show" aria-labelledby="flipLetterDemoHeading">
            <div class="accordion-body">
              <img src="<%= asset_path('flip_letter_demo.png') %>" alt="How to flip letters" class="img-fluid" />
            </div>
          </div>
        </div>
      </div>
      <div class="col col-md-auto">
        <div class="row">
          <% 
          flip_letters = generate_random_combo_of_flip_letters
          # col_w = (12 / flip_letters.size.to_f).ceil 
          flip_letters.each_with_index do |flip_letter, fp_index| 
            checkbox_index = 0
            # Store encrypted parameter names for use in the form
            encrypted_letter_param = evaluate_param_name(flip_letter.letter.upcase)
          %>
            <%= hidden_field_tag evaluate_param_name("letters[]"), flip_letter.letter.upcase %>
            <div class="flip-letter col col-md-auto">
              <div class="card">
                <div class="card-header text-bg-dark text-center">
                  <h5 class="card-title mb-0"><%= flip_letter.letter %></h5>
                </div>
                <div class="card-body text-center">
                  <table style="margin: 0 auto;">
                    <tbody>
                      <% 1.upto(FlipToWords::FlipLetter::ROWS_FOR_LETTER) do |row| %>
                        <tr>
                          <% 1.upto(FlipToWords::FlipLetter::COLUMNS_FOR_LETTER) do |col| 
                            encrypted_checkbox_name = evaluate_param_name("#{flip_letter.letter}[#{checkbox_index}]")
                          %>
                            <td class="letter-position-cell">
                              <%= check_box_tag encrypted_checkbox_name, 1, false, { class: "letter-position-checkbox", data: { 'bs-toggle': 'tooltip', 'bs-title': 'Check the boxes to make it look like the correct letter' } } %>
                              <% checkbox_index += 1 %>
                            </td>
                          <% end %>
                        </tr>
                      <% end # each row %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% end # each flip_letter %>
        </div>
        <div class="mt-3">
          <%= submit_tag "Submit", class: "btn btn-primary", data: { disable_with: "Submitting..." } %>
          <span class="m-2">&nbsp;</span>
          <% if flash[:notice] %>
            <span class="alert alert-success"><%= flash[:notice] %></span>
          <% elsif flash[:alert] %>
            <span class="alert alert-danger"><%= flash[:alert] %></span>
          <% end %>
        </div>
        <div class="flip-letter mt-3">
          <div class="card" style="display: grid; grid-template-columns: repeat(<%= FlipToWords::FlipLetter::COLUMNS_FOR_LETTER %>, 1fr); gap: 5px;">
            <% 1.upto(FlipToWords::FlipLetter::ROWS_FOR_LETTER) do |row| %>
              <% 1.upto(FlipToWords::FlipLetter::COLUMNS_FOR_LETTER) do |col| %>
                <span class="letter-position-label" style=""><%= "#{row},#{col}" %></span>
              <% end %>
            <% end %>
          </div>
      </div>
    </div>
  <% end # form %>
</div>